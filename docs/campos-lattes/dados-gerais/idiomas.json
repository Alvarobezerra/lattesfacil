{
  "secao": "Dados gerais",
  "item": "Idiomas",
  "menu": "megamenu2",
  "como_abrir": "Dados gerais > Idiomas",
  "formularios": [
    {
      "url": "pkg_idioma.form?f_cod=<codigo_do_cv>",
      "total_campos_nomeados": 10,
      "abas": [
        {
          "aba": "Idioma",
          "campos": [
            {
              "tipo": "select",
              "name": "F_COD_IDIOMA",
              "rotulo_provavel": "Selecione o idioma :",
              "catalogo": "catalogos/idiomas-149.json",
              "total_opcoes": 150
            },
            {
              "tipo": "checkbox",
              "name": "FC_LE",
              "opcoes": {
                "Lê": "on"
              }
            },
            {
              "tipo": "radio",
              "name": "F_LE",
              "opcoes": {
                "Pouco": "P",
                "Razoavelmente": "R",
                "Bem": "B"
              }
            },
            {
              "tipo": "checkbox",
              "name": "FC_CONVERSA",
              "opcoes": {
                "Fala": "on"
              }
            },
            {
              "tipo": "radio",
              "name": "F_CONVERSA",
              "opcoes": {
                "Pouco": "P",
                "Razoavelmente": "R",
                "Bem": "B"
              }
            },
            {
              "tipo": "checkbox",
              "name": "FC_ESCREVE",
              "opcoes": {
                "Escreve": "on"
              }
            },
            {
              "tipo": "radio",
              "name": "F_ESCREVE",
              "opcoes": {
                "Pouco": "P",
                "Razoavelmente": "R",
                "Bem": "B"
              }
            },
            {
              "tipo": "checkbox",
              "name": "FC_COMPR",
              "opcoes": {
                "Compreende": "on"
              }
            },
            {
              "tipo": "radio",
              "name": "F_COMPR",
              "opcoes": {
                "Pouco": "P",
                "Razoavelmente": "R",
                "Bem": "B"
              }
            }
          ]
        },
        {
          "aba": "Visibilidade",
          "campos": [
            {
              "tipo": "text",
              "name": "f_tipo_privacidade",
              "oculto_inicialmente": true,
              "rotulo_provavel": "Privado: As informações não serão exibidas na consulta pública."
            }
          ],
          "campos_de_busca_ou_visibilidade": 2
        }
      ],
      "ocultos": [
        "f_cod",
        "f_ctr",
        "f_seq"
      ],
      "salvar": [
        "check();return false;"
      ],
      "validacao_mensagens": [
        "Informe o Idioma",
        "Campo Idioma obrigatório não informado.",
        "Informe ao menos uma das modalidades de nivel",
        "Informe ao menos uma das modalidades de nível."
      ],
      "campos_obrigatorios_segundo_mensagens": [
        "Idioma"
      ]
    }
  ],
  "observacoes": [],
  "lista": "pkg_idioma.lista?f_cod=<codigo_do_cv>",
  "abertura": {
    "tipo": "direta",
    "url_do_formulario": "pkg_idioma.form?f_cod=<codigo_do_cv>",
    "como": "modalCV2.setarUrl(<url>, true) na janela de topo"
  }
}