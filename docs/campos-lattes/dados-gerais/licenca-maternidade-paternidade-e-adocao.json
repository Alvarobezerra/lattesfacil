{
  "secao": "Dados gerais",
  "item": "Licença Maternidade, Paternidade e Adoção",
  "menu": "megamenu2",
  "como_abrir": "Dados gerais > Licença Maternidade, Paternidade e Adoção",
  "formularios": [
    {
      "url": "pkg_licenca.form?f_cod=<codigo_do_cv>",
      "total_campos": 7,
      "campos": [
        {
          "tipo": "select",
          "name": "f_tipo_licenca",
          "rotulo_provavel": "Tipo",
          "opcoes": [
            "=",
            "M=Maternidade",
            "P=Paternidade",
            "A=Adoção"
          ]
        },
        {
          "tipo": "text",
          "name": "f_dta_inicio",
          "id": "dp1794759971061",
          "maxlength": 10,
          "rotulo_provavel": "Data Fim"
        },
        {
          "tipo": "text",
          "name": "f_dta_fim",
          "id": "dp1794759971062",
          "maxlength": 10,
          "rotulo_provavel": "Data Fim"
        },
        {
          "tipo": "text",
          "name": "f_dta_nasc_adoc",
          "id": "dp1794759971063",
          "maxlength": 10,
          "rotulo_provavel": "Data de nascimento/adoção"
        },
        {
          "tipo": "select",
          "rotulo_provavel": "Privado: As informações não serão exibidas na consulta pública.",
          "opcoes": [
            "1=Público",
            "2=Privado"
          ],
          "anonimo": true
        },
        {
          "tipo": "text",
          "name": "f_tipo_privacidade",
          "rotulo_provavel": "Privado: As informações não serão exibidas na consulta pública."
        },
        {
          "tipo": "text",
          "rotulo_provavel": "Privado",
          "anonimo": true
        }
      ],
      "ocultos": [
        "f_cod",
        "f_ctr",
        "f_seq"
      ],
      "abas": [
        "Visibilidade"
      ],
      "salvar": [
        "check();return false;"
      ]
    }
  ],
  "observacoes": [],
  "lista": "pkg_licenca.lista?f_cod=<codigo_do_cv>",
  "abertura": {
    "tipo": "direta",
    "url_do_formulario": "pkg_licenca.form?f_cod=<codigo_do_cv>",
    "como": "modalCV2.setarUrl(<url>, true) na janela de topo"
  }
}