{
  "secao": "Dados gerais",
  "item": "Prêmios e títulos",
  "menu": "megamenu2",
  "como_abrir": "Dados gerais > Prêmios e títulos",
  "formularios": [
    {
      "url": "pkg_premio.form?f_cod=<codigo_do_cv>",
      "total_campos_nomeados": 4,
      "abas": [
        {
          "aba": "Prêmios e títulos honoríficos recebidos",
          "campos": [
            {
              "tipo": "text",
              "name": "f_titulo",
              "maxlength": 200,
              "rotulo_provavel": "Nome do prêmio ou título"
            },
            {
              "tipo": "text",
              "name": "f_agencia",
              "maxlength": 100,
              "rotulo_provavel": "Entidade promotora"
            },
            {
              "tipo": "text",
              "name": "f_ano",
              "maxlength": 4,
              "rotulo_provavel": "Ano da premiação ou do título"
            }
          ]
        },
        {
          "aba": "Visibilidade",
          "campos": [
            {
              "tipo": "text",
              "name": "f_tipo_privacidade",
              "oculto_inicialmente": true,
              "rotulo_provavel": "Privado: As informações não serão exibidas na consulta pública."
            }
          ],
          "campos_de_busca_ou_visibilidade": 2
        }
      ],
      "ocultos": [
        "f_cod",
        "f_ctr",
        "f_seq"
      ],
      "janelas_auxiliares": [
        "del();"
      ],
      "salvar": [
        "check();return false;"
      ],
      "validacao_mensagens": [
        "Informe o Nome do titulo",
        "Campo Nome do prêmio ou título obrigatório não informado.",
        "Informe o Ano da Premiacao",
        "Campo Ano da premiação ou do título obrigatório não informado.",
        "Ano invalido. Informe do formato 9999",
        "Ano inválido. O ano deve estar no formato 9999.",
        "Ano nao pode ser menor que Ano Nascimento",
        "Ano não pode ser menor que ano nascimento.",
        "Ano nao pode ser maior que Ano Atual",
        "Ano da premiação inválido. Ano não pode ser maior que o ano atual e deve estar no formato 9999"
      ],
      "campos_obrigatorios_segundo_mensagens": [
        "Nome do prêmio ou título",
        "Ano da premiação ou do título"
      ]
    }
  ],
  "observacoes": [],
  "lista": "pkg_premio.lista?f_cod=<codigo_do_cv>",
  "abertura": {
    "tipo": "direta",
    "url_do_formulario": "pkg_premio.form?f_cod=<codigo_do_cv>",
    "como": "modalCV2.setarUrl(<url>, true) na janela de topo"
  }
}