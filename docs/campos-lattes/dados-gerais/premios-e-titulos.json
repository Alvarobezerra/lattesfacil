{
  "secao": "Dados gerais",
  "item": "Prêmios e títulos",
  "menu": "megamenu2",
  "como_abrir": "Dados gerais > Prêmios e títulos",
  "formularios": [
    {
      "url": "pkg_premio.form?f_cod=<codigo_do_cv>",
      "total_campos": 6,
      "campos": [
        {
          "tipo": "text",
          "name": "f_titulo",
          "maxlength": 200,
          "rotulo_provavel": "Nome do prêmio ou título"
        },
        {
          "tipo": "text",
          "name": "f_agencia",
          "maxlength": 100,
          "rotulo_provavel": "Entidade promotora"
        },
        {
          "tipo": "text",
          "name": "f_ano",
          "maxlength": 4,
          "rotulo_provavel": "Ano da premiação ou do título"
        },
        {
          "tipo": "select",
          "rotulo_provavel": "Privado: As informações não serão exibidas na consulta pública.",
          "opcoes": [
            "1=Público",
            "2=Privado"
          ],
          "anonimo": true
        },
        {
          "tipo": "text",
          "name": "f_tipo_privacidade",
          "rotulo_provavel": "Privado: As informações não serão exibidas na consulta pública."
        },
        {
          "tipo": "text",
          "rotulo_provavel": "Público",
          "anonimo": true
        }
      ],
      "ocultos": [
        "f_cod",
        "f_ctr",
        "f_seq"
      ],
      "abas": [
        "Visibilidade"
      ],
      "janelas_auxiliares": [
        "del();"
      ],
      "salvar": [
        "check();return false;"
      ]
    }
  ],
  "observacoes": [],
  "lista": "pkg_premio.lista?f_cod=<codigo_do_cv>",
  "abertura": {
    "tipo": "direta",
    "url_do_formulario": "pkg_premio.form?f_cod=<codigo_do_cv>",
    "como": "modalCV2.setarUrl(<url>, true) na janela de topo"
  }
}