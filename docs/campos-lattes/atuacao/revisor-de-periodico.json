{
  "secao": "Atuação",
  "item": "Revisor de periódico",
  "menu": "megamenu4",
  "como_abrir": "Atuação > Revisor de periódico",
  "formularios": [
    {
      "url": "PKG_REVISOR.inclui?f_cod=<codigo_do_cv>&f_natur=RV&f_origem=L",
      "total_campos_nomeados": 8,
      "abas": [
        {
          "aba": "Periódico",
          "campos": [
            {
              "tipo": "text",
              "name": "f_nme_agencia",
              "maxlength": 255,
              "desabilitado": true,
              "rotulo_provavel": "Periódico"
            }
          ]
        },
        {
          "aba": "Período",
          "campos": [
            {
              "tipo": "text",
              "name": "f_mes_ini",
              "maxlength": 2,
              "rotulo_provavel": "Mês"
            },
            {
              "tipo": "text",
              "name": "f_ano_ini",
              "maxlength": 4,
              "rotulo_provavel": "Ano"
            },
            {
              "tipo": "radio",
              "name": "f_status",
              "opcoes": {
                "S": "S",
                "N": "N"
              }
            },
            {
              "tipo": "text",
              "name": "f_mes_fim",
              "maxlength": 2,
              "oculto_inicialmente": true,
              "rotulo_provavel": "Mês"
            },
            {
              "tipo": "text",
              "name": "f_ano_fim",
              "maxlength": 4,
              "oculto_inicialmente": true,
              "rotulo_provavel": "Ano"
            }
          ]
        },
        {
          "aba": "Outras informações",
          "campos": [
            {
              "tipo": "textarea",
              "name": "f_outras_inf",
              "maxlength": 3950,
              "rotulo_provavel": "Outras informações"
            }
          ]
        },
        {
          "aba": "Visibilidade",
          "campos": [
            {
              "tipo": "text",
              "name": "f_tipo_privacidade",
              "oculto_inicialmente": true,
              "rotulo_provavel": "Privado: As informações não serão exibidas na consulta pública."
            }
          ],
          "campos_de_busca_ou_visibilidade": 2
        }
      ],
      "ocultos": [
        "f_cod",
        "f_cod_inst",
        "f_cod_inst2",
        "f_codinst",
        "f_ctr",
        "f_inst_old",
        "f_instold",
        "f_issn",
        "f_issn_h",
        "f_natur",
        "f_nme_agencia_h",
        "f_origem",
        "f_seq_ativ",
        "f_seq_funcao_ativ",
        "f_seq_hist",
        "f_seq_per"
      ],
      "janelas_auxiliares": [
        "periodico();"
      ],
      "salvar": [
        "check();return false;"
      ],
      "validacao_mensagens": [
        "Campo Periódico obrigatório não informado.",
        "Campo Início obrigatório não informado.",
        "Ano início não pode ser maior que ano atual.",
        "Ano início não pode ser menor que ano nascimento.",
        "Campo Fim obrigatório não informado.",
        "Mês início inválido.",
        "Ano de início inválido. O ano deve estar no formato 9999.",
        "Mês fim inválido.",
        "Ano fim inválido. Ano deve estar no formato 9999.",
        "Data de início deve ser menor que data fim.",
        "Não informe ano fim se o status do período for atual."
      ],
      "campos_obrigatorios_segundo_mensagens": [
        "Periódico",
        "Início",
        "Fim"
      ]
    }
  ],
  "observacoes": [],
  "lista": "pkg_revisor.lista?f_natur=RV&f_cod=<codigo_do_cv>",
  "abertura": {
    "tipo": "direta",
    "url_do_formulario": "PKG_REVISOR.inclui?f_cod=<codigo_do_cv>&f_natur=RV&f_origem=L",
    "como": "modalCV2.setarUrl(<url>, true) na janela de topo"
  }
}