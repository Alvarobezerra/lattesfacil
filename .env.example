# Copie para .env (que NÃO vai para o Git) e preencha. Nunca coloque valores reais aqui.

# Servidor
HOST=127.0.0.1
PORT=8000
LATTESFACIL_CODIGO=            # código de acesso, mínimo 10 caracteres (se vazio, é gerado)
LATTESFACIL_HTTPS=0            # 1 em produção (cookies seguros)
LATTESFACIL_DB=                # caminho do banco SQLite (padrão: lattes_records.db)

# IA (Gemini)
GEMINI_ENABLED=0               # 1 para ligar
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODE=hibrido

# Citações
OPENALEX_API_KEY=
