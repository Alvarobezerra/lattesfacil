{
  "manifest_version": 3,
  "name": "NautiScience — Automação Currículo Lattes",
  "version": "0.9.7",
  "description": "Conecta o NautiScience ao Currículo Lattes: aguarda login na 1ª vez, abre o formulário certo sozinho e cadastra com 1 clique.",
  "permissions": ["scripting", "tabs", "storage", "cookies"],
  "host_permissions": [
    "https://*.cnpq.br/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://lattesfacil.onrender.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://lattesfacil.onrender.com/*"
      ],
      "js": ["content-app.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://wwws.cnpq.br/*"
      ],
      "js": ["content-lattes.js"],
      "run_at": "document_idle"
    }
  ]
}
